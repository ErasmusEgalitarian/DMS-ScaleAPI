<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:AvaloniaAppUpdatedVersion.ViewModels"
			 xmlns:converters="clr-namespace:AvaloniaAppUpdatedVersion.Converters;assembly=AvaloniaAppUpdatedVersion"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="AvaloniaAppUpdatedVersion.Views.LoginPageView"
			 x:DataType="vm:LoginPageViewModel">
	<Design.DataContext>
		<!-- This only sets the DataContext for the previewer in an IDE,
         to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
		<vm:LoginPageViewModel />
	</Design.DataContext>

	<UserControl.Resources>
		<converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
	</UserControl.Resources>

	<Border Background="#060A23">
		<DockPanel Margin="">
			<StackPanel>
				<!--Top -->
				<Border Background="#070B2A">
					<TextBlock Text="Scale Manager"
						HorizontalAlignment="Center"
						VerticalAlignment="Top"
						Margin="20"
						FontSize="26"/>
				</Border>

				<!--Content -->

				<TextBlock Name="LoginText"
						Text="Please login with your username and password"
						HorizontalAlignment="Center"
						VerticalAlignment="Top"
						Margin="0 60 0 20"
						FontSize="16"/>

				<TextBox Padding="10"
						 Margin="250 5"
						 VerticalContentAlignment="Center"
						 Watermark="Username"
						 AcceptsReturn="False"
						 FontSize="14"
						 MaxLines="1"
						 Width="300"/>
				
				<TextBox Padding="10"
						 Margin="250 5"
						 VerticalContentAlignment="Center"
						 Watermark="Password"
						 AcceptsReturn="False"
						 FontSize="14"
						 MaxLines="1"
						 Width="300"/>

				<!--Bottom -->
					<Button Name="LoginButton"
						Background="#0E6BA8"
						Content="LOGIN"
						VerticalContentAlignment="Center"
						HorizontalContentAlignment="Center"
						HorizontalAlignment="Center"
						VerticalAlignment="Bottom"
						Width="200"
						Height="30"
						Margin="0 50 0 0"
						CornerRadius="5"
						Command="{Binding LoginCommand}"
						IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
				<TextBlock Name="ErrorMessage"
						Text="{Binding ErrorMessage}"
						HorizontalAlignment="Center"
						VerticalAlignment="Bottom"
						Margin="20"
						FontSize="12"/>
			

			</StackPanel>
		</DockPanel>
	</Border>
</UserControl>
