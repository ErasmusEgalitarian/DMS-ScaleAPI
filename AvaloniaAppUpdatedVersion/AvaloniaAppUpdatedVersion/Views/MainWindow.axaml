<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AvaloniaAppUpdatedVersion.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:AvaloniaAppUpdatedVersion.Views"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="800"
		Width="1400" Height="800"
		MinWidth="1400" MinHeight="800"
        x:Class="AvaloniaAppUpdatedVersion.Views.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="AvaloniaAppUpdatedVersion">
        <views:SidebarMenuView DataContext="{Binding}" />
</Window>
