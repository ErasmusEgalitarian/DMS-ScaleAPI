<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:AvaloniaAppUpdatedVersion.ViewModels"
			 xmlns:views="clr-namespace:AvaloniaAppUpdatedVersion.Views"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="800"
             x:Class="AvaloniaAppUpdatedVersion.Views.ScaleOverviewPageView"
			 x:DataType="vm:ScaleOverviewPageViewModel">

	<Design.DataContext>
		<!-- This only sets the DataContext for the previewer in an IDE,
         to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
		<vm:ScaleOverviewPageViewModel />
	</Design.DataContext>

	<ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
					Background="#0A1843">
		<StackPanel Margin="20" Spacing="10">
			<TextBlock Text="Scale Overview" FontSize="50" FontWeight="Bold" TextAlignment="Center" />

			<TextBlock Text="Status overview of all scales" FontSize="24" TextAlignment="Center" />

			<Grid Name="MainGrid" 
				  ShowGridLines="False"
				  Margin="50"
				  Background="#0A1843"
				  RowDefinitions="250, 250"
				  ColumnDefinitions="*, *">

				<Border Grid.Column="0" Grid.Row="0" Background="#0E6BA8" Width="300" Height="175" CornerRadius="30"/>
				<Border Grid.Column="1" Grid.Row="0" Background="#0E6BA8" Width="300" Height="175" CornerRadius="30"/>
				<Border Grid.Column="0" Grid.Row="1" Background="#0E6BA8" Width="300" Height="175" CornerRadius="30"/>
				<Border Grid.Column="1" Grid.Row="1" Background="#0E6BA8" Width="300" Height="175" CornerRadius="30"/>

				<TextBlock Grid.Column="0" Grid.Row="0" Text="Scale 1" FontWeight="Bold" FontSize="32" TextAlignment="Center"/>
				<TextBlock Grid.Column="1" Grid.Row="0" Text="Scale 2" FontWeight="Bold" FontSize="32" TextAlignment="Center"/>
				<TextBlock Grid.Column="0" Grid.Row="1" Text="Scale 3" FontWeight="Bold" FontSize="32" TextAlignment="Center"/>
				<TextBlock Grid.Column="1" Grid.Row="1" Text="Scale 4" FontWeight="Bold" FontSize="32" TextAlignment="Center"/>

				<Button Grid.Column="0" Grid.Row="0" Width="300" Height="175" HorizontalAlignment="Center" CornerRadius="30" Background="DarkGreen"
						Command="{Binding ToScale1Command}">
					<Path Data="{StaticResource ScalesRegular}" Fill="Black" Width="80" Height="80" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
				</Button>
				<Button Grid.Column="1" Grid.Row="0" Width="300" Height="175" HorizontalAlignment="Center" CornerRadius="30" Background="DarkGreen"
						Command="{Binding ToScale1Command}">
					<Path Data="{StaticResource ScalesRegular}" Fill="Black" Width="80" Height="80" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
				</Button>
				<Button Grid.Column="0" Grid.Row="1" Width="300" Height="175" HorizontalAlignment="Center" CornerRadius="30" Background="DarkGreen"
						Command="{Binding ToScale1Command}">
					<Path Data="{StaticResource ScalesRegular}" Fill="Black" Width="80" Height="80" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
				</Button>
				<Button Grid.Column="1" Grid.Row="1" Width="300" Height="175" HorizontalAlignment="Center" CornerRadius="30" Background="DarkGreen"
						Command="{Binding ToScale1Command}">
					<Path Data="{StaticResource ScalesRegular}" Fill="Black" Width="80" Height="80" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>				
				</Button>
				
				</Grid>

			<ContentControl Content="{Binding CurrentPage}" />
		</StackPanel>
		
	</ScrollViewer>
</UserControl>
