<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="using:AvaloniaAppUpdatedVersion.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="800"
             x:Class="AvaloniaAppUpdatedVersion.Views.UploadFirmwarePageView"
	         x:DataType="vm:UploadFirmwarePageViewModel">
	<Design.DataContext>
		<!-- This only sets the DataContext for the previewer in an IDE,
         to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
		<vm:UploadFirmwarePageViewModel />
	</Design.DataContext>

	<Border Background="#0A1843">
		<StackPanel Margin="20" Spacing="10">
			<TextBlock Text="Upload Firmware" FontSize="50" FontWeight="Bold" TextAlignment="Center" />
			<TextBlock Text="Select the firmware file to upload" FontSize="24" TextAlignment="Center" />

			<Grid Name="MainGrid"
				  ShowGridLines="False"
				  Margin="50"
				  Background="#0A1843"
				  RowDefinitions="Auto, Auto, Auto"
				  ColumnDefinitions="*, *">

			<Button Name="SelectFirmwareButton"
					Grid.Column="0"
					Command="{Binding SelectFirmwareCommand}"
					Background="#0E6BA8"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Height="500"
					Width="600"
					Foreground="White"
					CornerRadius="30">
				<TextBlock Text="Select Firmware File"
						   FontSize="40"
						   FontWeight="Bold"
						   TextAlignment="Center"
						   VerticalAlignment="Center"/>
				
			</Button>
			<TextBlock Name="SelectedFileText"
					   Text="{Binding SelectedFilePath}"
					   FontSize="16"
					   HorizontalAlignment="Center"
					   VerticalAlignment="Top"
					   Margin="0 50 0 0"/>
			<Button Name="UploadButton"
					Grid.Column="1"
					Command="{Binding UploadFirmwareCommand}"
					IsEnabled="{Binding IsUploadEnabled}"
					Background="#0E6BA8"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Height="500"
					Width="600"
					Foreground="White"
					CornerRadius="30">
				<TextBlock Text="Upload Firmware"
						   FontSize="40"
						   FontWeight="Bold"
						   TextAlignment="Center"
						   VerticalAlignment="Center"/>
			</Button>

				</Grid>

			<TextBlock Name="StatusText"
					   Text="{Binding StatusMessage}"
					   FontSize="18"
					   HorizontalAlignment="Center"
					   Margin="0 10 0 0"/>

		</StackPanel>

	</Border>
	
</UserControl>
